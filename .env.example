# Imisoro Guide - environment template.
# Copy to `.env` and fill in real values. NEVER commit .env.

# --- LLM (primary: Fikra API, OpenAI-compatible) ---------------------------
LLM_BASE_URL=https://api.fikraapi.co.ke/v1
LLM_API_KEY=fk_live_your_key_here
CHAT_MODEL=deepseek-v4.1-flash
LLM_FALLBACK_MODELS=gemini-4-hydrogen,qwen3.8-max,glm-5.3-flash

# --- LLM fallback provider (optional second provider, e.g. Rodium / imole) --
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_KEY=
LLM_FALLBACK_MODEL=

# --- LLM runtime ------------------------------------------------------------
LLM_CONCURRENCY=4
LLM_MAX_TOKENS=1500

# --- Embeddings (multilingual) ---------------------------------------------
EMBED_URL=http://127.0.0.1:7867/embed

# --- Connect server (QR pairing page) --------------------------------------
CONNECT_PORT=3010
# AUTH_DIR=                 # defaults to ./data/auth-imisoro

# --- Data dir (optional, defaults to ./data) -------------------------------
# DATA_DIR=

# --- OCR (optional, for the facture upload bonus phase) --------------------
OCR_ENABLED=0
OCR_API_KEY=

# --- Transcription (optional, voice notes on WhatsApp phase) ---------------
ASSEMBLYAI_API_KEY=
